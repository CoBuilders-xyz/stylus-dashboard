# Envio HyperIndex configuration
#
# For Arbitrum One mainnet (HyperSync) - get free at https://envio.dev/app/api-tokens
# ENVIO_API_TOKEN=your-token-here
#
# Note: envio dev manages its own PostgreSQL (port 5433) and Hasura (port 8080)
# No need to set DATABASE_URL for local development.

# Entities Hasura exposes aggregate fields for (StylusContract_aggregate).
# The overview page needs count(StylusContract) without downloading the table.
# Must be a JSON array: the plain-string form splits on "&" and rejects a
# single name. Only re-applied when the storage initializes (reset or empty
# DB), so an already-synced deployment also needs the permission set through
# the Hasura metadata API.
ENVIO_HASURA_PUBLIC_AGGREGATE=["StylusContract"]
