{
  "name": "@stylus-dashboard/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "envio codegen",
    "codegen": "envio codegen",
    "dev": "envio dev",
    "dev:reset": "envio dev -r",
    "start": "envio start",
    "test": "ENVIO_CONFIG=config.arbitrum-local.yaml envio codegen && ENVIO_CONFIG=config.arbitrum-local.yaml vitest run",
    "typecheck": "envio codegen --config config.arbitrum-local.yaml && tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "envio": "^3.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  }
}
